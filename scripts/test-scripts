#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
for script in install.sh uninstall.sh verify-install-kvm.sh scripts/setup-host scripts/setup-venv scripts/prepare-kvm-install-source scripts/prepare-kvm-base-images scripts/kvm-base-image scripts/kvm-base-dir scripts/kvm-vm scripts/kvm-smoke-tmux scripts/kvm-console-wait scripts/check-dependencies scripts/update-dependencies scripts/test-scripts scripts/test-rhel-install-source scripts/check-nested-kvm-capability scripts/check-nested-kvm-idempotence scripts/test-nested-kvm scripts/virsh-network-mac tests/test-virsh-network-mac.sh; do
  bash -n "$repo_root/$script"
done
bash -n "$repo_root/tests/test-kvm-image-validation.sh"
bash -n "$repo_root/tests/test-kvm-ssh-user-forwarding.sh"
bash "$repo_root/tests/test-kvm-image-validation.sh"
bash "$repo_root/tests/test-kvm-ssh-user-forwarding.sh"
bash "$repo_root/tests/test-kvm-host-validation.sh"
bash "$repo_root/tests/test-check-dependencies.sh"
bash "$repo_root/tests/test-nested-kvm-capability.sh"
bash "$repo_root/tests/test-nested-kvm-cli.sh"
bash "$repo_root/tests/test-virsh-network-mac.sh"
PYTHONDONTWRITEBYTECODE=1 python3 "$repo_root/scripts/test-nested-ipv4.py"
"$repo_root/scripts/test-rhel-install-source"
printf 'Shell syntax checks passed.\n'
