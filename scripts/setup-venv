#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
usage() {
  printf 'Usage: %s <ansible-min|ansible-current|ansible-next>\n' "$0" >&2
}
environment=${1:-}
[[ -d "$repo_root/environments/$environment" ]] || { usage; exit 2; }

python_version=$(awk -v key="${environment#ansible-}:" '
  /^python:/ { in_python = 1; next }
  /^[^[:space:]#]/ { in_python = 0 }
  in_python && $1 == key { gsub(/"/, "", $2); print $2; exit }
' "$repo_root/versions.yml")
[[ -n "$python_version" ]] || { printf 'Python pin not found for %s\n' "$environment" >&2; exit 1; }
python_bin="python${python_version}"
if [[ ! -x $(command -v "$python_bin" 2>/dev/null || true) && -r /etc/os-release ]]; then
  # Fedora ships its current Python as python3; older parallel minor versions
  # are not necessarily available as installable RPMs.
  # shellcheck disable=SC1091
  . /etc/os-release
  if [[ ${ID:-} == fedora && ${VERSION_ID%%.*} =~ ^(43|44)$ ]] && command -v python3 >/dev/null; then
    python_bin=python3
  fi
fi
command -v "$python_bin" >/dev/null || {
  printf '%s is required. Install it with: scripts/setup-host install all\n' "$python_bin" >&2
  exit 1
}

venv="$repo_root/.venv/$environment"
"$python_bin" -m venv --clear "$venv"
"$venv/bin/python" -m pip install --disable-pip-version-check -r "$repo_root/environments/$environment/requirements.txt"
"$venv/bin/ansible-galaxy" collection install \
  --collections-path "$venv/collections" \
  -r "$repo_root/environments/$environment/requirements.yml"

# Expose shared lifecycle files and pinned collections to role repositories.
cat >>"$venv/bin/activate" <<ACTIVATE_HOOK

# Idarsi Ansible test environment integration.
export IDARSI_TEST_ENVIRONMENT=$(printf '%q' "$repo_root")
_idarsi_collections_path=$(printf '%q' "$venv/collections")
case ":\${ANSIBLE_COLLECTIONS_PATH:-}:" in
  *":\$_idarsi_collections_path:"*) ;;
  *) export ANSIBLE_COLLECTIONS_PATH="\$_idarsi_collections_path\${ANSIBLE_COLLECTIONS_PATH:+:\$ANSIBLE_COLLECTIONS_PATH}" ;;
esac
unset _idarsi_collections_path
if [[ -z \${IDARSI_TEST_KVM_INSTALL_SOURCE:-} && -r $(printf '%q' "$repo_root/.kvm-install-source") ]]; then
  IFS= read -r IDARSI_TEST_KVM_INSTALL_SOURCE <$(printf '%q' "$repo_root/.kvm-install-source")
  export IDARSI_TEST_KVM_INSTALL_SOURCE
fi
if [[ -z \${IDARSI_TEST_KVM_INSTALL_SOURCE_ROCKY10:-} && -r $(printf '%q' "$repo_root/.kvm-install-source-rocky10") ]]; then
  IFS= read -r IDARSI_TEST_KVM_INSTALL_SOURCE_ROCKY10 <$(printf '%q' "$repo_root/.kvm-install-source-rocky10")
  export IDARSI_TEST_KVM_INSTALL_SOURCE_ROCKY10
fi
if [[ -z \${IDARSI_TEST_KVM_INSTALL_SOURCE_RHEL9:-} && -r $(printf '%q' "$repo_root/.kvm-install-source-rhel9") ]]; then
  IFS= read -r IDARSI_TEST_KVM_INSTALL_SOURCE_RHEL9 <$(printf '%q' "$repo_root/.kvm-install-source-rhel9")
  export IDARSI_TEST_KVM_INSTALL_SOURCE_RHEL9
fi
if [[ -z \${IDARSI_TEST_KVM_INSTALL_SOURCE_RHEL10:-} && -r $(printf '%q' "$repo_root/.kvm-install-source-rhel10") ]]; then
  IFS= read -r IDARSI_TEST_KVM_INSTALL_SOURCE_RHEL10 <$(printf '%q' "$repo_root/.kvm-install-source-rhel10")
  export IDARSI_TEST_KVM_INSTALL_SOURCE_RHEL10
fi
ACTIVATE_HOOK
printf 'Created %s\nActivate with: source %s/bin/activate\n' "$venv" "$venv"
