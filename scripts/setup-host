#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
state_user=${SUDO_USER:-${USER:-$(id -un)}}
state_user_home=$(getent passwd "$state_user" | cut -d: -f6)
state_user_home=${state_user_home:-$HOME}
state_home=${XDG_STATE_HOME:-$state_user_home/.local/state}
repo_id=$(printf '%s' "$repo_root" | sha256sum | cut -c1-16)
state_dir="$state_home/idarsi-ansible-test-environments/$repo_id"

usage() {
  printf 'Usage: %s check|install podman|kvm|all\n' "$0" >&2
}

[[ $# -eq 2 ]] || { usage; exit 2; }
action=$1
profile=$2
[[ "$action" == check || "$action" == install ]] || { usage; exit 2; }
case "$profile" in
  podman) packages=(git python3.12 python3.12-pip openssh-clients tmux podman) ;;
  kvm) packages=(curl git python3.12 python3.12-pip openssh-clients tmux qemu-kvm libvirt libvirt-daemon-kvm libvirt-daemon-config-network virt-install virt-viewer libguestfs-tools-c) ;;
  all) packages=(curl git python3.12 python3.12-pip openssh-clients tmux podman qemu-kvm libvirt libvirt-daemon-kvm libvirt-daemon-config-network virt-install virt-viewer libguestfs-tools-c) ;;
  *) usage; exit 2 ;;
esac

[[ -r /etc/os-release ]] || { printf 'Cannot identify host OS\n' >&2; exit 1; }
# shellcheck disable=SC1091
. /etc/os-release
case "${ID:-}:${VERSION_ID%%.*}" in
  rocky:10) distro=rocky ;;
  fedora:44) distro=fedora ;;
  *)
    printf 'Host setup supports Rocky Linux 10 and Fedora 44; detected %s %s\n' "${ID:-unknown}" "${VERSION_ID:-unknown}" >&2
    exit 1
    ;;
esac

missing=()
missing_rpm_names=()
for package in "${packages[@]}"; do
  case "$package" in
    python3.12) rpm_name=python3 ;;
    python3.12-pip) rpm_name=python3-pip ;;
    libvirt) [[ $distro == fedora ]] && rpm_name=libvirt-client || rpm_name=libvirt ;;
    libguestfs-tools-c) rpm_name=guestfs-tools ;;
    *) rpm_name=$package ;;
  esac
  if ! rpm -q "$rpm_name" >/dev/null 2>&1; then
    missing+=("$rpm_name")
    missing_rpm_names+=("$rpm_name")
  fi
done

needs_libvirt=false
if [[ "$profile" == kvm || "$profile" == all ]]; then
  systemctl is-enabled --quiet libvirtd && systemctl is-active --quiet libvirtd || needs_libvirt=true
fi
requesting_user=${SUDO_USER:-${USER:-}}
needs_libvirt_group=false
if [[ ( "$profile" == kvm || "$profile" == all ) && -n "$requesting_user" && "$requesting_user" != root ]]; then
  id -nG "$requesting_user" 2>/dev/null | tr ' ' '\n' | grep -qx libvirt || needs_libvirt_group=true
fi
needs_network=false
needs_test_network=false
needs_base_pool=false
base_dir=/var/lib/libvirt/images/idarsi-test-bases
needs_kvm_device=false
if [[ "$profile" == kvm || "$profile" == all ]]; then
  base_dir=$("$repo_root/scripts/kvm-base-dir")
  network_info=$(virsh --connect qemu:///system net-info default 2>/dev/null || true)
  if [[ -z "$network_info" ]] || ! awk -F: '/^Active:/ {gsub(/[[:space:]]/, "", $2); active=$2} /^Autostart:/ {gsub(/[[:space:]]/, "", $2); autostart=$2} END {exit(active == "yes" && autostart == "yes" ? 0 : 1)}' <<<"$network_info"; then
    needs_network=true
  fi
  test_network_info=$(virsh --connect qemu:///system net-info idarsi-test 2>/dev/null || true)
  if [[ -z "$test_network_info" ]]; then
    needs_test_network=true
  else
    test_network_xml=$(virsh --connect qemu:///system net-dumpxml idarsi-test)
    if ! python3 - "$repo_root/config/idarsi-test-network.xml" "$test_network_xml" <<'PY'
import sys
import xml.etree.ElementTree as ET
expected = ET.parse(sys.argv[1]).getroot()
actual = ET.fromstring(sys.argv[2])
def identity(root):
    bridge, ip = root.find('bridge'), root.find('ip')
    if bridge is None or ip is None:
        return None
    return root.findtext('name'), bridge.get('name'), ip.get('address'), ip.get('netmask')
def shape(root):
    forwarding = root.find('forward')
    ip = root.find('ip')
    dhcp = None if ip is None else ip.find('dhcp')
    ranges = [] if dhcp is None else dhcp.findall('range')
    return (identity(root), None if forwarding is None else forwarding.get('mode'),
            None if len(ranges) != 1 else (ranges[0].get('start'), ranges[0].get('end')))
if shape(actual) != (identity(expected), 'nat', ('192.168.250.100', '192.168.250.199')):
    raise SystemExit(1)
PY
    then
      printf 'Conflicting libvirt idarsi-test network; refusing to replace it.\n' >&2
      exit 1
    fi
    if ! awk -F: '/^Active:/ {gsub(/[[:space:]]/, "", $2); active=$2} /^Autostart:/ {gsub(/[[:space:]]/, "", $2); autostart=$2} END {exit(active == "yes" && autostart == "yes" ? 0 : 1)}' <<<"$test_network_info"; then
      needs_test_network=true
    fi
  fi
  pool_info=$(virsh --connect qemu:///system pool-info idarsi-test-bases 2>/dev/null || true)
  if [[ -n "$pool_info" ]]; then
    pool_xml=$(virsh --connect qemu:///system pool-dumpxml idarsi-test-bases)
    read -r pool_type pool_target < <(python3 -c 'import sys,xml.etree.ElementTree as E; r=E.fromstring(sys.stdin.read()); print(r.get("type", ""), r.findtext("target/path", ""))' <<<"$pool_xml")
    if [[ "$pool_type" != dir || "$pool_target" != "$base_dir" ]]; then
      printf 'Conflicting idarsi-test-bases pool target %s (expected %s); refusing to replace it.\n' "$pool_target" "$base_dir" >&2
      exit 1
    fi
    if ! awk -F: '/^State:/ {gsub(/[[:space:]]/, "", $2); active=($2 == "running")} /^Autostart:/ {gsub(/[[:space:]]/, "", $2); autostart=($2 == "yes")} END {exit(active && autostart ? 0 : 1)}' <<<"$pool_info"; then needs_base_pool=true; fi
  else
    needs_base_pool=true
  fi
  [[ -d "$base_dir" ]] || needs_base_pool=true
  [[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]] || needs_kvm_device=true
fi

if [[ ${#missing[@]} -eq 0 && $needs_libvirt == false && $needs_libvirt_group == false && $needs_network == false && $needs_test_network == false && $needs_base_pool == false && $needs_kvm_device == false ]]; then
  printf 'All %s host requirements are ready.\n' "$profile"
  exit 0
fi
if [[ ${#missing[@]} -gt 0 ]]; then
  printf 'Missing packages: %s\n' "${missing[*]}"
fi
if [[ $needs_libvirt == true ]]; then
  printf 'libvirtd is not both enabled and active.\n' >&2
fi
if [[ $needs_libvirt_group == true ]]; then
  printf 'User %s is not a member of the libvirt group.\n' "$requesting_user" >&2
fi
if [[ $needs_network == true ]]; then
  printf 'libvirt default network is not both active and set to autostart.\n' >&2
fi
if [[ $needs_test_network == true ]]; then
  printf 'libvirt idarsi-test network is missing or not both active and set to autostart.\n' >&2
fi
if [[ $needs_base_pool == true ]]; then
  printf 'libvirt idarsi-test-bases pool is missing or not both active and set to autostart, or its base directory is missing.\n' >&2
fi
if [[ $needs_kvm_device == true ]]; then
  printf 'The current user cannot access /dev/kvm, or hardware virtualization is unavailable.\n' >&2
fi
[[ "$action" == install ]] || exit 1

if [[ ${#missing[@]} -gt 0 ]]; then
  if [[ $EUID -eq 0 ]]; then
    dnf install -y "${missing[@]}"
  else
    command -v sudo >/dev/null || { printf 'sudo is required to install host packages\n' >&2; exit 1; }
    sudo dnf install -y "${missing[@]}"
  fi
  mkdir -p "$state_dir"
  for package in "${missing_rpm_names[@]}"; do
    if ! grep -Fxq "$package" "$state_dir/installed-packages" 2>/dev/null; then
      printf '%s\n' "$package" >>"$state_dir/installed-packages"
    fi
  done
fi

if [[ "$profile" == kvm || "$profile" == all ]]; then
  if [[ $needs_libvirt_group == true ]]; then
    if [[ $EUID -eq 0 ]]; then
      usermod -aG libvirt "$requesting_user"
    else
      sudo usermod -aG libvirt "$requesting_user"
    fi
    mkdir -p "$state_dir"
    printf '%s\n' "$requesting_user" >"$state_dir/libvirt-group-user"
  fi
  if [[ $EUID -eq 0 ]]; then
    systemctl enable --now libvirtd
  else
    sudo systemctl enable --now libvirtd
  fi
  if [[ $EUID -eq 0 ]]; then
    virsh_admin=(virsh --connect qemu:///system)
  else
    virsh_admin=(sudo virsh --connect qemu:///system)
  fi
  if ! "${virsh_admin[@]}" net-info default >/dev/null 2>&1; then
    default_network=/usr/share/libvirt/networks/default.xml
    if [[ -r "$default_network" ]]; then
      "${virsh_admin[@]}" net-define "$default_network"
    else
      printf 'No libvirt default network definition found at %s\n' "$default_network" >&2
      exit 1
    fi
  fi
  network_info=$("${virsh_admin[@]}" net-info default)
  if ! awk -F: '/^Active:/ {gsub(/[[:space:]]/, "", $2); found=($2 == "yes")} END {exit(found ? 0 : 1)}' <<<"$network_info"; then
    "${virsh_admin[@]}" net-start default
  fi
  "${virsh_admin[@]}" net-autostart default >/dev/null
  if ! "${virsh_admin[@]}" net-info idarsi-test >/dev/null 2>&1; then
    "${virsh_admin[@]}" net-define "$repo_root/config/idarsi-test-network.xml"
  else
    net_xml=$("${virsh_admin[@]}" net-dumpxml idarsi-test)
    python3 - "$repo_root/config/idarsi-test-network.xml" "$net_xml" <<'PY'
import sys, xml.etree.ElementTree as ET
expected=ET.parse(sys.argv[1]).getroot(); actual=ET.fromstring(sys.argv[2])
def fields(r):
    f=r.find('forward'); b=r.find('bridge'); ip=r.find('ip'); dhcp=None if ip is None else ip.find('dhcp'); ranges=[] if dhcp is None else dhcp.findall('range')
    return (r.findtext('name'), None if f is None else f.get('mode'), None if b is None else b.get('name'), None if ip is None else ip.get('address'), None if ip is None else ip.get('netmask'), [] if dhcp is None else [(x.get('start'),x.get('end')) for x in ranges])
if fields(actual) != ('idarsi-test','nat','virbr-idarsi','192.168.250.1','255.255.255.0',[('192.168.250.100','192.168.250.199')]):
    raise SystemExit('Conflicting libvirt idarsi-test network; refusing to replace it.')
PY
  fi
  test_network_info=$("${virsh_admin[@]}" net-info idarsi-test)
  if ! awk -F: '/^Active:/ {gsub(/[[:space:]]/, "", $2); found=($2 == "yes")} END {exit(found ? 0 : 1)}' <<<"$test_network_info"; then
    "${virsh_admin[@]}" net-start idarsi-test
  fi
  "${virsh_admin[@]}" net-autostart idarsi-test >/dev/null
  if [[ $EUID -eq 0 ]]; then sudo_cmd=(); else sudo_cmd=(sudo); fi
  "${sudo_cmd[@]}" mkdir -p "$base_dir"
  "${sudo_cmd[@]}" chown "${SUDO_USER:-${USER:-root}}:libvirt" "$base_dir"
  "${sudo_cmd[@]}" chmod 0755 "$base_dir"
  if command -v restorecon >/dev/null 2>&1; then "${sudo_cmd[@]}" restorecon -F "$base_dir"; fi
  if ! "${virsh_admin[@]}" pool-info idarsi-test-bases >/dev/null 2>&1; then
    pool_xml=$(mktemp)
    python3 - "$base_dir" >"$pool_xml" <<'PY'
import sys
import xml.etree.ElementTree as ET
pool = ET.Element('pool', {'type': 'dir'})
ET.SubElement(pool, 'name').text = 'idarsi-test-bases'
ET.SubElement(ET.SubElement(pool, 'target'), 'path').text = sys.argv[1]
ET.ElementTree(pool).write(sys.stdout, encoding='unicode')
PY
    "${virsh_admin[@]}" pool-define "$pool_xml"
    rm -f "$pool_xml"
  fi
  pool_info=$("${virsh_admin[@]}" pool-info idarsi-test-bases)
  if ! awk -F: '/^State:/ {gsub(/[[:space:]]/, "", $2); active=($2 == "running")} END {exit(active ? 0 : 1)}' <<<"$pool_info"; then
    "${virsh_admin[@]}" pool-start idarsi-test-bases
  fi
  "${virsh_admin[@]}" pool-autostart idarsi-test-bases >/dev/null
  if [[ $needs_kvm_device == true ]]; then
    printf 'KVM packages are installed, but this session still cannot use /dev/kvm. Check firmware virtualization and device permissions.\n' >&2
  else
    printf 'KVM packages and libvirt networks (default, idarsi-test) are ready.\n'
  fi
  if [[ $needs_libvirt_group == true ]]; then
    printf 'Added %s to the libvirt group; log out and back in before using KVM.\n' "$requesting_user"
  fi
fi
