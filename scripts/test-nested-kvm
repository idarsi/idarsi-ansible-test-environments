#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
if [[ ${IDARSI_RUN_NESTED_KVM_TEST:-} != 1 ]]; then
  printf 'SKIP: set IDARSI_RUN_NESTED_KVM_TEST=1 to opt in to the nested KVM integration test.\n'
  exit 0
fi
role_path=${KVM_NESTED_ROLE_PATH:-${IDARSI_KVM_ROLE_PATH:-}}
iso=
while (($#)); do
  case $1 in
    --role-path) (($# >= 2)) || { echo 'FAIL: --role-path requires a directory.' >&2; exit 1; }; role_path=$2; shift 2 ;;
    --role-path=*) role_path=${1#*=}; shift ;;
    --help) echo 'Usage: test-nested-kvm [ISO] [--role-path ROLE_DIRECTORY]'; exit 0 ;;
    -*) echo "FAIL: unknown option: $1" >&2; exit 2 ;;
    *) [[ -z $iso ]] || { echo 'FAIL: only one ISO path may be provided.' >&2; exit 2; }; iso=$1; shift ;;
  esac
done
iso=${iso:-${IDARSI_TEST_KVM_INSTALL_SOURCE_ROCKY10:-}}
[[ -n $role_path ]] || { printf 'FAIL: provide the KVM role directory with --role-path or KVM_NESTED_ROLE_PATH.\n' >&2; exit 1; }
role_path=$(cd "$role_path" 2>/dev/null && pwd) || { printf 'FAIL: KVM role directory is unavailable: %s\n' "$role_path" >&2; exit 1; }
[[ -f $role_path/tasks/main.yml && -f $role_path/requirements.yml ]] || { printf 'FAIL: not an ansible-iac-roles-kvm role directory: %s\n' "$role_path" >&2; exit 1; }
if [[ -z $iso || ! -r $iso || ! -f $iso ]]; then
  printf 'FAIL: provide a readable Rocky 10 install ISO as argument or IDARSI_TEST_KVM_INSTALL_SOURCE_ROCKY10.\n' >&2
  exit 1
fi
for tool in virsh virt-install ssh ssh-keygen tar python3; do
  command -v "$tool" >/dev/null || { printf 'FAIL: required command missing: %s\n' "$tool" >&2; exit 1; }
done
[[ -r /dev/kvm && -w /dev/kvm ]] || { printf 'SKIP: /dev/kvm is unavailable or not writable; nested virtualization is unsupported here.\n'; exit 0; }
if "$repo_root/scripts/check-nested-kvm-capability"; then
  :
else
  capability_status=$?
  [[ $capability_status == 77 ]] && exit 0
  exit "$capability_status"
fi
uri=${KVM_LIBVIRT_URI:-qemu:///system}
umask 077
work=$(mktemp -d "${TMPDIR:-/tmp}/idarsi-nested-kvm.XXXXXXXX")
hash=$(printf '%s' "$work" | sha256sum | cut -c1-8)
outer="nested-kvm-${hash}"
export MOLECULE_EPHEMERAL_DIRECTORY="$work/molecule"
mkdir -m 700 "$MOLECULE_EPHEMERAL_DIRECTORY"
cleanup() {
  local status=$?
  trap - EXIT INT TERM
  if ((status != 0)); then
    if [[ -n ${address:-} ]]; then
      printf '\n--- nested libvirt diagnostics (before cleanup) ---\n' >&2
      ssh -F /dev/null -i "$MOLECULE_EPHEMERAL_DIRECTORY/kvm_ed25519" -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        "molecule@$address" "for n in 'inner-$hash' 'image-$hash'; do echo === \$n ===; sudo virsh domstate \$n; sudo virsh domiflist \$n; sudo virsh domifaddr \$n --source lease; done" >&2 || true
    fi
    for log in "$work"/*ansible-run-*.log; do
      [[ -f $log ]] || continue
      printf '\n--- %s ---\n' "${log##*/}" >&2
      cat "$log" >&2
    done
  fi
  if [[ -n ${address:-} ]]; then
    ssh -F /dev/null -i "$MOLECULE_EPHEMERAL_DIRECTORY/kvm_ed25519" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
      "molecule@$address" "for name in 'inner-$hash' 'image-$hash'; do sudo virsh destroy \"\$name\" >/dev/null 2>&1 || true; sudo virsh undefine \"\$name\" --remove-all-storage >/dev/null 2>&1 || true; done" >/dev/null 2>&1 || true
  fi
  # The inner VM and its disk exist only inside this uniquely owned outer VM.
  # Destroying the outer VM on the host is the ultimate cleanup, even if SSH fails.
  if ! MOLECULE_EPHEMERAL_DIRECTORY="$MOLECULE_EPHEMERAL_DIRECTORY" KVM_LIBVIRT_URI="$uri" \
    "$repo_root/scripts/kvm-vm" destroy "$outer"; then
    printf 'FAIL: could not destroy outer guest %s; cleanup may be incomplete.\n' "$outer" >&2
    status=1
  fi
  rm -rf -- "$work"
  exit "$status"
}
address=
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

wait_guest_ssh() {
  local ip=$1 deadline=$2
  while ((SECONDS < deadline)); do
    if ssh -F /dev/null -i "$key" -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
      "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$ip 'test -f /etc/rocky-release'" >/dev/null 2>&1; then return 0; fi
    sleep 3
  done
  return 1
}
validate_ipv4() {
  python3 -c 'import ipaddress,sys; ipaddress.IPv4Address(sys.argv[1])' "$1" >/dev/null 2>&1
}

export MOLECULE_SCENARIO_DIRECTORY="$repo_root/molecule/kvm-smoke"
export KVM_LIBVIRT_URI="$uri" KVM_CPU_HOST_PASSTHROUGH=true
export KVM_VCPUS=${KVM_NESTED_OUTER_VCPUS:-4} KVM_MEMORY_MB=${KVM_NESTED_OUTER_MEMORY_MB:-8192}
export KVM_INSTALL_TIMEOUT=${KVM_NESTED_INSTALL_TIMEOUT:-3600}
export KVM_BASE_IMAGE_MODE=off
result=$("$repo_root/scripts/kvm-vm" create "$outer" "$iso" "$repo_root/examples/molecule-kvm/rocky9-10.ks.tmpl")
address=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["address"])' "$result")
key="$MOLECULE_EPHEMERAL_DIRECTORY/kvm_ed25519"

# Install this checkout's KVM host setup in the outer guest, then run the
# selected KVM role there to provision the inner guest.
# Transfer only the files needed to install and exercise this checkout. This
# intentionally excludes inventory, SSH material, local configuration, and Git metadata.
tar -C "$repo_root" -czf "$work/repo.tgz" \
  config/idarsi-test-network.xml scripts/setup-host scripts/kvm-base-dir
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
  "molecule@$address" 'mkdir -p ~/nested-kvm-repo'
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
  "molecule@$address" 'python3 -c '\''import pathlib, sys, tarfile; tarfile.open(fileobj=sys.stdin.buffer, mode="r|gz").extractall(path=pathlib.Path.home() / "nested-kvm-repo", filter="data")'\''' < "$work/repo.tgz"
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
  "molecule@$address" "sudo env IDARSI_ENABLE_NESTED_KVM=1 bash ~/nested-kvm-repo/scripts/setup-host install kvm"
scp -F /dev/null -i "$key" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$iso" "molecule@$address:/tmp/nested-kvm-install.iso"
inner="inner-$hash"
inner_key="$work/inner_ed25519"
ssh-keygen -q -t ed25519 -N '' -f "$inner_key"
network='network --bootproto=dhcp --device=link --activate'
python3 - "$repo_root/examples/molecule-kvm/rocky9-10.ks.tmpl" "$work/inner.ks" "$inner_key.pub" "$network" <<'PY'
from pathlib import Path
import sys
template = Path(sys.argv[1]).read_text()
pubkey = Path(sys.argv[3]).read_text().strip()
for token in ('@@SSH_USER@@', '@@SSH_PUBLIC_KEY@@', '@@NETWORK_CONFIGURATION@@'):
    if token not in template:
        raise SystemExit(f'Kickstart template is missing {token}')
Path(sys.argv[2]).write_text(template.replace('@@SSH_USER@@', 'molecule').replace('@@SSH_PUBLIC_KEY@@', pubkey).replace('@@NETWORK_CONFIGURATION@@', sys.argv[4]))
PY
chmod 600 "$work/inner.ks"
inner_address=192.168.250.210
scp -F /dev/null -i "$key" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$work/inner.ks" "molecule@$address:/tmp/inner.ks"
scp -F /dev/null -i "$key" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$inner_key" "$inner_key.pub" "molecule@$address:/tmp/"
# Transfer only executable role content; never include VCS metadata, tests,
# local secrets, or developer configuration. Dependencies are resolved in a
# private path on the outer guest.
tar -C "$role_path" --exclude=.git --exclude=.env --exclude='*secret*' --exclude='*credential*' \
  -czf "$work/kvm-role.tgz" defaults filter_plugins tasks templates requirements.yml
scp -F /dev/null -i "$key" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$work/kvm-role.tgz" "molecule@$address:/tmp/kvm-role.tgz"
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "install -d -m 700 \"\$HOME/.ssh/nested-kvm\" && install -m 600 /tmp/inner_ed25519 \"\$HOME/.ssh/nested-kvm/inner_ed25519\" && install -m 644 /tmp/inner_ed25519.pub \"\$HOME/.ssh/nested-kvm/inner_ed25519.pub\" && rm -f /tmp/inner_ed25519 /tmp/inner_ed25519.pub"
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "sudo dnf install -y ansible-core lorax && sudo install -d -m 755 /opt/idarsi-nested-kvm/role /opt/idarsi-nested-kvm/collections && sudo tar -xzf /tmp/kvm-role.tgz -C /opt/idarsi-nested-kvm/role && sudo chown -R molecule:molecule /opt/idarsi-nested-kvm && ansible-galaxy collection install -r /opt/idarsi-nested-kvm/role/requirements.yml -p /opt/idarsi-nested-kvm/collections"
python3 "$repo_root/scripts/render-nested-kvm-playbook" "$work/playbook.yml" "$inner"
playbook_dir=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  'dir=$(mktemp -d "$HOME/nested-kvm-playbook.XXXXXX") && chmod 0700 "$dir" && printf "%s" "$dir"')
scp -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
  "$work/playbook.yml" "molecule@$address:$playbook_dir/playbook.yml"
for run in 1 2; do
  ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
    "sudo env ANSIBLE_COLLECTIONS_PATH=/opt/idarsi-nested-kvm/collections ansible-playbook '$playbook_dir/playbook.yml'" \
    2>&1 | tee "$work/ansible-run-$run.log"
  if ((run == 2)); then
    "$repo_root/scripts/check-nested-kvm-idempotence" "$work/ansible-run-$run.log"
  fi
done
for ((i=0; i<360; i++)); do
  if ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh dominfo '$inner' >/dev/null && ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$inner_address 'test -f /etc/rocky-release'" >/dev/null 2>&1; then break; fi
  sleep 5
done
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "sudo virsh dominfo '$inner' >/dev/null && ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$inner_address 'test -f /etc/rocky-release'"
hostname=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$inner_address 'hostnamectl --static'")
[[ $hostname == nested-role-integration.example.test ]] || {
  printf 'FAIL: inner guest static hostname is %q, expected nested-role-integration.example.test.\n' "$hostname" >&2
  exit 1
}
guest_ipv4=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$inner_address 'ip -4 -o address show scope global'" | awk '{split($4, a, "/"); print a[1]}' | grep -Fx '192.168.250.210')
[[ $guest_ipv4 == 192.168.250.210 ]] || { printf 'FAIL: inner guest does not have expected static IPv4 address.\n' >&2; exit 1; }
# Keep the Kickstart profile intact but prevent it from reconnecting on a clone.
# A separate DHCP profile bound to the source's NIC name avoids stale static
# identity/address data while retaining autoconnect on the clone's virtio NIC.
active_nic=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$inner_address 'nmcli -t -f UUID,DEVICE connection show --active | awk -F: '\''\$2 != \"lo\" {print \$1 \" \" \$2; exit}'\''' ")
read -r connection_uuid nic_device <<< "$active_nic"
[[ $connection_uuid =~ ^[[:xdigit:]-]{36}$ && $nic_device =~ ^[[:alnum:]_.:-]+$ ]] || { printf 'FAIL: invalid active NetworkManager profile/NIC identity: %q\n' "$active_nic" >&2; exit 1; }
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$inner_address 'sudo nmcli connection modify uuid $connection_uuid connection.autoconnect no && sudo nmcli connection add type ethernet con-name nested-image-dhcp ifname $nic_device connection.autoconnect yes ipv4.method auto ipv6.method disabled'"
source_boot_id=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$inner_address 'cat /proc/sys/kernel/random/boot_id'")
[[ $source_boot_id =~ ^[[:xdigit:]-]{36}$ ]] || { printf 'FAIL: invalid source guest boot ID before reboot: %q; check guest SSH authentication/connectivity.\n' "$source_boot_id" >&2; exit 1; }
if ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$inner_address 'sudo systemctl reboot'" >/dev/null 2>&1; then
  :
else
  reboot_status=$?
  # SSH status 255 is expected when reboot drops the transport. Strict-auth
  # commands below verify recovery; profile and authentication failures remain fatal.
  [[ $reboot_status == 255 ]] || { printf 'FAIL: reboot command failed with SSH status %s.\n' "$reboot_status" >&2; exit 1; }
fi
source_mac=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "sudo virsh domiflist '$inner'" | "$repo_root/scripts/virsh-network-mac")
[[ $source_mac =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] || { printf 'FAIL: invalid source NIC MAC: %q\n' "$source_mac" >&2; exit 1; }
lease_deadline=$((SECONDS + 180)); source_lease=
while ((SECONDS < lease_deadline)); do
  source_lease=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
    "sudo virsh domifaddr '$inner' --source lease | awk -v mac='$source_mac' 'tolower(\$2)==mac && \$4 ~ /^[0-9]+\\./ {sub(/\\/.*/,\"\",\$4); print \$4}'" 2>/dev/null) || source_lease=
  validate_ipv4 "$source_lease" && break
  sleep 3
done
validate_ipv4 "$source_lease" || { printf 'FAIL: no valid IPv4 DHCP lease found for source NIC %s.\n' "$source_mac" >&2; exit 1; }
wait_guest_ssh "$source_lease" "$((SECONDS + 180))" || { printf 'FAIL: DHCP source lease %s failed SSH verification after reboot (previous boot ID: %s).\n' "$source_lease" "$source_boot_id" >&2; exit 1; }
source_new_boot_id=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$source_lease 'cat /proc/sys/kernel/random/boot_id'")
if [[ ! $source_new_boot_id =~ ^[[:xdigit:]-]{36}$ || $source_new_boot_id == "$source_boot_id" ]]; then
  printf 'FAIL: reboot not verified (before boot ID: %s, after boot ID: %s, DHCP lease: %s).\n' \
    "$source_boot_id" "${source_new_boot_id:-unavailable}" "$source_lease" >&2
  ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
    "sudo virsh domstate '$inner'; sudo virsh domifaddr '$inner' --source lease" >&2 || true
  exit 1
fi
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh shutdown '$inner'"
shutdown_deadline=$((SECONDS + 240))
while ((SECONDS < shutdown_deadline)); do
  state=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh domstate '$inner'" 2>/dev/null | tr -d '\r') || state=
  [[ $state == 'shut off' ]] && break
  sleep 2
done
[[ $state == 'shut off' ]] || { printf 'FAIL: ISO source guest %s did not reach shut off state within 240 seconds (last state: %s).\n' "$inner" "${state:-unavailable}" >&2; exit 1; }
image_vm="image-$hash"
source_disk=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh domblklist --details '$inner' | awk '\$2 == \"disk\" {print \$4; exit}'")
[[ $source_disk == /* && $source_disk == *.qcow2 && $source_disk != *$'\n'* ]] || { printf 'FAIL: invalid discovered qcow2 source disk path: %q\n' "$source_disk" >&2; exit 1; }
printf -v source_disk_q '%q' "$source_disk"
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "test -f $source_disk_q && sudo qemu-img check -f qcow2 $source_disk_q"
image_tmp="/var/lib/libvirt/images/$image_vm.qcow2.tmp"
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "printf 'incomplete image fixture\\n' | sudo tee '$image_tmp' >/dev/null"
python3 "$repo_root/scripts/render-nested-kvm-playbook" "$work/image-playbook.yml" "$image_vm" "$source_disk" --state vm_present
scp -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$work/image-playbook.yml" "molecule@$address:$playbook_dir/image-playbook.yml"
for run in 1 2; do
  ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
    "sudo env ANSIBLE_COLLECTIONS_PATH=/opt/idarsi-nested-kvm/collections ansible-playbook '$playbook_dir/image-playbook.yml'" \
    2>&1 | tee "$work/image-ansible-run-$run.log"
  if ((run == 2)); then "$repo_root/scripts/check-nested-kvm-idempotence" "$work/image-ansible-run-$run.log"; fi
done
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "test ! -e '$image_tmp'"
clone_deadline=$((SECONDS + 180)); clone_state=unavailable; clone_lease=
while ((SECONDS < clone_deadline)); do
  clone_state=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh domstate '$image_vm'" 2>/dev/null | tr -d '\r') || clone_state=unavailable
  if [[ $clone_state == running ]]; then
    clone_mac=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh domiflist '$image_vm'" 2>/dev/null | "$repo_root/scripts/virsh-network-mac") || clone_mac=
    if [[ $clone_mac =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]; then
      clone_lease=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh domifaddr '$image_vm' --source lease | awk -v mac='$clone_mac' 'tolower(\$2)==mac && \$4 ~ /^[0-9]+\\./ {sub(/\\/.*/,\"\",\$4); print \$4}'" 2>/dev/null) || clone_lease=
      if validate_ipv4 "$clone_lease" && wait_guest_ssh "$clone_lease" "$((SECONDS + 15))"; then break; fi
    fi
  fi
  sleep 3
done
if ((SECONDS >= clone_deadline)); then
  printf 'FAIL: clone %s did not become running with a valid DHCP lease and reachable Rocky SSH before timeout (state=%s, MAC=%s, lease=%s).\n' "$image_vm" "$clone_state" "${clone_mac:-unavailable}" "${clone_lease:-unavailable}" >&2
  exit 1
fi
clone_hostname=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$clone_lease 'hostnamectl --static'")
[[ $clone_hostname == nested-role-integration.example.test ]] || { printf 'FAIL: image clone static hostname is %q, expected nested-role-integration.example.test.\n' "$clone_hostname" >&2; exit 1; }
clone_ipv4=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "ssh -F /dev/null -i \$HOME/.ssh/nested-kvm/inner_ed25519 -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null molecule@$clone_lease 'ip -4 -o address show scope global'" | awk '{split($4, a, "/"); print a[1]}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -n1)
[[ $clone_ipv4 == "$clone_lease" ]] || { printf 'FAIL: clone IPv4 %s does not match its libvirt lease %s.\n' "$clone_ipv4" "$clone_lease" >&2; exit 1; }
source_state=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh domstate '$inner'" | tr -d '\r')
[[ $source_state == 'shut off' ]] || { printf 'FAIL: ISO source guest %s is not shut off after image clone provisioning (state: %s).\n' "$inner" "$source_state" >&2; exit 1; }

# Exercise both removal scopes while all artifacts and package checks remain in
# the disposable outer guest. The ISO disk is deliberately retained by default.
run_role_state() {
  local name=$1 state=$2 purge=$3 check_mode=${4:-}
  local rendered="$work/$name-$state.yml"
  python3 "$repo_root/scripts/render-nested-kvm-playbook" "$rendered" "$name" --state "$state" --purge-data-on-remove "$purge"
  scp -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$rendered" "molecule@$address:$playbook_dir/$name-$state.yml"
  ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
    "sudo env ANSIBLE_COLLECTIONS_PATH=/opt/idarsi-nested-kvm/collections ansible-playbook $check_mode '$playbook_dir/$name-$state.yml'" \
    2>&1 | tee "$work/$name-$state.log"
}
# Blueprint-only validation is supported in check mode. Every mutation state is
# rejected by the role's preflight guard before host inspection or changes.
run_role_state "$image_vm" validate false --check
for mutating_state in install vm_present vm_absent absent; do
  if run_role_state "$image_vm" "$mutating_state" false --check; then
    printf 'FAIL: state %s unexpectedly succeeded in check mode.\n' "$mutating_state" >&2
    exit 1
  fi
  grep -Fq 'mutations are not supported in check mode' "$work/$image_vm-$mutating_state.log"
done
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "sudo virsh dominfo '$inner' >/dev/null && sudo virsh dominfo '$image_vm' >/dev/null && rpm -q qemu-kvm libvirt virt-install qemu-img lorax >/dev/null"
iso_disk=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh domblklist --details '$inner' | awk '\$2 == \"disk\" {print \$4; exit}'")
run_role_state "$inner" vm_absent false
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "! sudo virsh dominfo '$inner' >/dev/null 2>&1 && test -f '$iso_disk'"
run_role_state "$inner" vm_absent false  # rerun must be a no-op
"$repo_root/scripts/check-nested-kvm-idempotence" "$work/$inner-vm_absent.log"
image_artifacts=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "sudo python3 -c 'import json,pathlib; p=pathlib.Path(\"/var/lib/libvirt/images/$image_vm.ansible-iac-role-kvm-owned\"); data=json.loads(p.read_text()); print(\"\\n\".join(data[\"artifacts\"]))'")
[[ -n $image_artifacts ]] || { printf 'FAIL: image ownership manifest contains no artifacts.\n' >&2; exit 1; }
while IFS= read -r artifact; do
  case $artifact in
    "$image_vm.qcow2"|"$image_vm.qcow2.tmp"|"$image_vm-install.iso"|"$image_vm-install.iso.inputs"|"$image_vm-install.ks") ;;
    *) printf 'FAIL: unexpected image artifact in ownership manifest: %q\n' "$artifact" >&2; exit 1 ;;
  esac
done <<<"$image_artifacts"
run_role_state "$image_vm" vm_absent true
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "! sudo virsh dominfo '$image_vm' >/dev/null 2>&1 && ! test -e '/var/lib/libvirt/images/$image_vm.ansible-iac-role-kvm-owned' && ! test -e '/var/lib/libvirt/images/$image_vm.qcow2'"
while IFS= read -r artifact; do
  ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
    "! test -e '/var/lib/libvirt/images/$artifact'" || { printf 'FAIL: manifest-listed image artifact remains after purge: %s\n' "$artifact" >&2; exit 1; }
done <<<"$image_artifacts"

# Define an explicitly unmanaged, powered-off fixture with the same blueprint
# name. The role must preserve it and must refuse package removal while any
# domain remains. The harness removes only this exact fixture after proving both.
sentinel="sentinel-$hash"
sentinel_xml="$work/unmanaged-sentinel.xml"
cat >"$sentinel_xml" <<EOF
<domain type='qemu'>
  <name>$sentinel</name>
  <title>ansible-iac-role-kvm-owned</title>
  <memory unit='MiB'>256</memory>
  <vcpu>1</vcpu>
  <os><type arch='x86_64'>hvm</type></os>
  <devices><emulator>/usr/libexec/qemu-kvm</emulator></devices>
</domain>
EOF
scp -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$sentinel_xml" "molecule@$address:/tmp/$inner-sentinel.xml"
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "sudo virsh define '/tmp/$inner-sentinel.xml' && rm -f '/tmp/$inner-sentinel.xml' && test ! -e '/var/lib/libvirt/images/$sentinel.ansible-iac-role-kvm-owned'"
sentinel_uuid=$(ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" "sudo virsh domuuid '$sentinel'")
if run_role_state "$sentinel" vm_absent false; then
  printf 'FAIL: vm_absent unexpectedly accepted title-spoofed unmanaged sentinel %s.\n' "$sentinel" >&2
  exit 1
fi
grep -Fq 'role ownership manifest is missing or unsafe' "$work/$sentinel-vm_absent.log"
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "test \"\$(sudo virsh domuuid '$sentinel')\" = '$sentinel_uuid' && sudo virsh dumpxml '$sentinel' | grep -Fq '<title>ansible-iac-role-kvm-owned</title>' && test ! -e '/var/lib/libvirt/images/$sentinel.ansible-iac-role-kvm-owned'"
if run_role_state "$sentinel" absent false; then
  printf 'FAIL: state absent unexpectedly accepted a remaining domain.\n' >&2
  exit 1
fi
grep -Fq 'Libvirt domains remain' "$work/$sentinel-absent.log"
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "sudo virsh dominfo '$sentinel' >/dev/null && rpm -q qemu-kvm libvirt virt-install qemu-img lorax >/dev/null"
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "sudo virsh destroy '$sentinel' >/dev/null 2>&1 || true; sudo virsh undefine '$sentinel'"
run_role_state "$inner" absent false
ssh -F /dev/null -i "$key" -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "molecule@$address" \
  "for package in qemu-kvm libvirt virt-install qemu-img lorax; do ! rpm -q \"\$package\" >/dev/null 2>&1 || exit 1; done"
run_role_state "$inner" absent false
"$repo_root/scripts/check-nested-kvm-idempotence" "$work/$inner-absent.log"
printf 'PASS: role %s provisioned ISO guest %s and image clone %s; both booted Rocky Linux.\n' "$role_path" "$inner" "$image_vm"
