#!/usr/bin/env bash
set -euo pipefail

if [[ -n ${IDARSI_RUN_ID:-} ]]; then
  printf 'Managed runs must use molecule/managed/create.yml and destroy.yml; the legacy VM launcher is disabled in this context.\n' >&2
  exit 2
fi

usage() {
  printf 'Usage: %s create|create-image|destroy|stop|start <molecule-instance> [install-source kickstart-template|qcow2-image]\n' "$0" >&2
}

[[ $# -ge 2 ]] || { usage; exit 2; }
action=$1
instance=$2
shift 2
[[ "$instance" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$ ]] || {
  printf 'Invalid Molecule instance name: %s\n' "$instance" >&2
  exit 2
}
[[ -n ${MOLECULE_EPHEMERAL_DIRECTORY:-} && -d $MOLECULE_EPHEMERAL_DIRECTORY ]] || {
  printf 'MOLECULE_EPHEMERAL_DIRECTORY must point to the active Molecule scenario directory\n' >&2
  exit 2
}

uri=${KVM_LIBVIRT_URI:-qemu:///system}
network=${KVM_NETWORK:-default}
ssh_user=${KVM_SSH_USER:-molecule}
ipv4_address=${KVM_IPV4_ADDRESS:-}
gateway=${KVM_GATEWAY:-192.168.250.1}
netmask=${KVM_NETMASK:-255.255.255.0}
nameserver=${KVM_NAMESERVER:-192.168.250.1}
key_file="$MOLECULE_EPHEMERAL_DIRECTORY/kvm_ed25519"
ownership_marker="$MOLECULE_EPHEMERAL_DIRECTORY/kvm-${instance}.uuid"
source "$(dirname "${BASH_SOURCE[0]}")/kvm-domain.sh"
idarsi_kvm_domain "$instance" "$MOLECULE_EPHEMERAL_DIRECTORY"
hash=$kvm_domain_hash
domain=$kvm_domain_name
virsh_cmd=(virsh --connect "$uri")

read_owned_uuid() {
  [[ ! -L $ownership_marker && -f $ownership_marker ]] || {
    printf 'VM ownership marker is missing or unsafe: %s\n' "$ownership_marker" >&2
    return 1
  }
  local marker
  marker=$(<"$ownership_marker")
  [[ $marker =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]] || {
    printf 'VM ownership marker is malformed: %s\n' "$ownership_marker" >&2
    return 1
  }
  printf '%s\n' "${marker,,}"
}

domain_is_absent() {
  local uuid=$1 names uuids
  names=$(LC_ALL=C "${virsh_cmd[@]}" list --all --name) || return 1
  if grep -Fxq -- "$domain" <<<"$names"; then return 1; fi
  if [[ -n $uuid ]]; then
    uuids=$(LC_ALL=C "${virsh_cmd[@]}" list --all --uuid) || return 1
    if grep -Fxiq -- "$uuid" <<<"$uuids"; then return 1; fi
  fi
  return 0
}

remove_owned_domain() {
  local uuid=$1 state
  state=$(LC_ALL=C "${virsh_cmd[@]}" domstate "$uuid" 2>&1) || return 1
  if [[ $state != 'shut off' && $state != shutoff ]]; then
    "${virsh_cmd[@]}" destroy "$uuid" || return 1
    state=$(LC_ALL=C "${virsh_cmd[@]}" domstate "$uuid" 2>&1) || return 1
    [[ $state == 'shut off' || $state == shutoff ]] || return 1
  fi
  "${virsh_cmd[@]}" undefine "$uuid" || return 1
  domain_is_absent "$uuid"
}

case "$action" in
  stop|start)
    [[ $# -eq 0 ]] || { usage; exit 2; }
    owned_uuid=$(read_owned_uuid) || exit 1
    actual_uuid=$("${virsh_cmd[@]}" domuuid "$domain") || { printf 'Unable to identify VM %s\n' "$domain" >&2; exit 1; }
    [[ ${actual_uuid,,} == "$owned_uuid" ]] || { printf 'VM %s UUID does not match its ownership marker; refusing mutation.\n' "$domain" >&2; exit 1; }
    if [[ "$action" == stop ]]; then
      state=$("${virsh_cmd[@]}" domstate "$owned_uuid") || exit 1
      if [[ $state != 'shut off' && $state != shutoff ]]; then
        "${virsh_cmd[@]}" destroy "$owned_uuid"
      fi
    else
      if [[ $("${virsh_cmd[@]}" domstate "$owned_uuid" 2>/dev/null || true) != running ]]; then
        "${virsh_cmd[@]}" start "$owned_uuid"
      fi
    fi
    ;;
  destroy)
    [[ $# -eq 0 ]] || { usage; exit 2; }
    base_dir=$("$(dirname "${BASH_SOURCE[0]}")/kvm-base-dir")
    overlay=$base_dir/${domain}.qcow2
    if [[ -L $ownership_marker ]]; then printf 'VM ownership marker is a symlink; refusing cleanup.\n' >&2; exit 1; fi
    if [[ ! -e $ownership_marker ]]; then
      if domain_is_absent '' && [[ ! -e $overlay && ! -L $overlay ]]; then
        printf 'Destroyed %s (%s) if it existed.\n' "$instance" "$domain"
        exit 0
      else
        printf 'VM %s or its overlay exists without an ownership marker; preserving resources.\n' "$domain" >&2
        exit 1
      fi
    fi
    owned_uuid=$(read_owned_uuid) || exit 1
    if dominfo_output=$("${virsh_cmd[@]}" dominfo "$domain" 2>&1); then
      domain_uuid=$("${virsh_cmd[@]}" domuuid "$domain") || exit 1
      [[ ${domain_uuid,,} == "$owned_uuid" ]] || { printf 'VM %s UUID does not match its ownership marker; refusing cleanup.\n' "$domain" >&2; exit 1; }
      remove_owned_domain "$owned_uuid" || { printf 'Unable to verify VM %s removal; preserving marker and overlay.\n' "$domain" >&2; exit 1; }
    elif domain_is_absent "$owned_uuid"; then
      : # A validated marker and both absent identities permit rerun cleanup.
    else
      printf 'Unable to query VM %s; preserving its overlay. virsh dominfo failed: %s\n' "$domain" "$dominfo_output" >&2
      exit 1
    fi
    if [[ -e "$overlay" ]]; then
      rm -f -- "$overlay"
    fi
    rm -f -- "$ownership_marker"
    printf 'Destroyed %s (%s) if it existed.\n' "$instance" "$domain"
    ;;
  create)
    image_mode=false
    [[ $# -eq 2 ]] || { usage; exit 2; }
    install_source=$1
    kickstart_template=$2
    ;;
  create-image)
    image_mode=true
    [[ $# -eq 1 ]] || { usage; exit 2; }
    install_source=$1
    kickstart_template=
    ;;
  *) usage; exit 2 ;;
esac

if [[ $action == create || $action == create-image ]]; then
    # A UUID unique to this invocation lets cleanup prove ownership even when
    # an unrelated domain appears under the reusable Molecule name.
    invocation_uuid=$(python3 -c 'import uuid; print(uuid.uuid4())')
    base_mode=${KVM_BASE_IMAGE_MODE:-auto}
    [[ "$base_mode" == auto || "$base_mode" == off ]] || { printf 'KVM_BASE_IMAGE_MODE must be auto or off\n' >&2; exit 2; }
    memory=${KVM_MEMORY_MB:-4096}
    vcpus=${KVM_VCPUS:-2}
    disk_size=${KVM_DISK_SIZE_GB:-30}
    timeout_seconds=${KVM_INSTALL_TIMEOUT:-3600}
    [[ "$memory" =~ ^[0-9]+$ && $memory -ge 1024 ]] || { printf 'KVM_MEMORY_MB must be an integer of at least 1024\n' >&2; exit 2; }
    [[ "$vcpus" =~ ^[0-9]+$ && $vcpus -ge 1 ]] || { printf 'KVM_VCPUS must be a positive integer\n' >&2; exit 2; }
    [[ "$disk_size" =~ ^[0-9]+$ && $disk_size -ge 10 ]] || { printf 'KVM_DISK_SIZE_GB must be an integer of at least 10\n' >&2; exit 2; }
    [[ "$timeout_seconds" =~ ^[0-9]+$ && $timeout_seconds -ge 60 ]] || { printf 'KVM_INSTALL_TIMEOUT must be at least 60 seconds\n' >&2; exit 2; }
    [[ "$ssh_user" =~ ^[a-z_][a-z0-9_-]{0,30}$ ]] || { printf 'KVM_SSH_USER is not a valid Linux username\n' >&2; exit 2; }
    command -v virt-install >/dev/null || { printf 'virt-install is required; run make setup-host PROFILE=kvm\n' >&2; exit 1; }
    command -v ssh-keygen >/dev/null || { printf 'ssh-keygen is required; run make setup-host PROFILE=kvm\n' >&2; exit 1; }
    command -v timeout >/dev/null || { printf 'timeout is required\n' >&2; exit 1; }
    if [[ -n "$install_source" && "$install_source" != base-only:* && "$install_source" != http://* && "$install_source" != https://* ]]; then
      if [[ "$install_source" != /* ]]; then
        install_source="${MOLECULE_SCENARIO_DIRECTORY:-$PWD}/$install_source"
      fi
      if [[ -e "$install_source" ]]; then install_source=$(realpath "$install_source"); fi
    fi
    if [[ $image_mode == true ]]; then
      [[ -f "$install_source" && -r "$install_source" ]] || { printf 'QCOW2 image must be a readable regular file: %s\n' "$install_source" >&2; exit 2; }
      install_source=$(realpath "$install_source")
      base_dir=$("$(dirname "${BASH_SOURCE[0]}")/kvm-base-dir")
      overlay="$base_dir/${domain}.qcow2"
      [[ ! -e "$overlay" && ! -L "$overlay" ]] || { printf 'Per-VM overlay already exists: %s. Run molecule destroy first.\n' "$overlay" >&2; exit 1; }
      command -v qemu-img >/dev/null || { printf 'qemu-img is required\n' >&2; exit 1; }
      [[ $(qemu-img info --output=json "$install_source" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("format", ""))') == qcow2 ]] || { printf 'Image source must be qcow2: %s\n' "$install_source" >&2; exit 2; }
    else
    if [[ "$kickstart_template" != /* ]]; then
      base_dir=${MOLECULE_SCENARIO_DIRECTORY:-$PWD}
      kickstart_template=$(realpath "$base_dir/$kickstart_template")
    else
      kickstart_template=$(realpath "$kickstart_template")
    fi
    [[ -r "$kickstart_template" ]] || { printf 'Kickstart template not found: %s\n' "$kickstart_template" >&2; exit 1; }
    fi
    "${virsh_cmd[@]}" dominfo "$domain" >/dev/null 2>&1 && {
      printf 'VM %s already exists. Run molecule destroy before creating it again.\n' "$domain" >&2
      exit 1
    }
    "${virsh_cmd[@]}" net-info "$network" >/dev/null 2>&1 || {
      printf 'libvirt network %s is unavailable at %s\n' "$network" "$uri" >&2
      exit 1
    }
    network_state=$("${virsh_cmd[@]}" net-info "$network" | awk -F: '/^Active:/ {gsub(/[[:space:]]/, "", $2); print $2}')
    if [[ "$network_state" != yes ]]; then
      "${virsh_cmd[@]}" net-start "$network" >&2
    fi
    if [[ ! -s "$key_file" ]]; then
      ssh-keygen -q -t ed25519 -N '' -C "molecule-$instance" -f "$key_file"
    fi
    chmod 600 "$key_file"
    public_key=$(<"$key_file.pub")
    base_image=
    base_dir=$("$(dirname "${BASH_SOURCE[0]}")/kvm-base-dir")
    overlay="$base_dir/${domain}.qcow2"
    overlay_tmp_dir=
    overlay_tmp_file=
    overlay_owned=false
    cleanup_overlay() {
      # A signal can arrive after ln publishes the target but before the
      # ownership flag is set. While the staging name remains, inode identity
      # proves that the published target is ours; never remove a foreign file.
      if [[ $overlay_owned == true || ( -n $overlay_tmp_file && -e $overlay && -e $overlay_tmp_file && $overlay -ef $overlay_tmp_file ) ]]; then
        rm -f -- "$overlay"
        overlay_owned=false
      fi
      if [[ -n $overlay_tmp_dir ]]; then
        rm -rf -- "$overlay_tmp_dir"
        overlay_tmp_dir=
        overlay_tmp_file=
      fi
    }
    create_overlay() {
      local backing=$1
      overlay_tmp_dir=$(mktemp -d "$base_dir/.${domain}.overlay.XXXXXXXX")
      overlay_tmp_file="$overlay_tmp_dir/overlay.qcow2"
      qemu-img create -f qcow2 -F qcow2 -b "$backing" "$overlay_tmp_file" >/dev/null
    }
    publish_overlay() {
      # link(2) is atomic and fails if the deterministic target already exists.
      # Ownership starts only after this invocation successfully publishes it.
      if ! ln -- "$overlay_tmp_file" "$overlay"; then
        printf 'Per-VM overlay already exists or could not be published: %s\n' "$overlay" >&2
        return 1
      fi
      overlay_owned=true
      rm -f -- "$overlay_tmp_file"
      rmdir -- "$overlay_tmp_dir"
      overlay_tmp_dir=
      overlay_tmp_file=
    }
    # This trap must cover image preparation too: qemu-img and guest
    # customization can fail before virt-install is reached.
    trap cleanup_overlay EXIT
    trap 'exit 1' HUP INT TERM
    if [[ $image_mode == true ]]; then
      command -v virt-customize >/dev/null || { printf 'virt-customize is required\n' >&2; exit 1; }
      if [[ -n "$ipv4_address" ]]; then
        printf 'Static IP config on image guests is not yet supported; use DHCP.\n' >&2
        exit 2
      fi
      network_file="$MOLECULE_EPHEMERAL_DIRECTORY/${domain}.nmconnection"
      cat >"$network_file" <<EOF
[connection]
id=idarsi-test-${instance}
type=ethernet
autoconnect=true
autoconnect-priority=999
match-device=type:ethernet
[ipv4]
method=auto
[ipv6]
method=auto
EOF
      chmod 600 "$network_file"
      create_overlay "$install_source"
      customize=(virt-customize -a "$overlay_tmp_file" --hostname "$instance" --ssh-inject "$ssh_user:file:$key_file.pub")
      customize+=(--upload "$network_file:/etc/NetworkManager/system-connections/99-idarsi-test.nmconnection" --chown 0:0:/etc/NetworkManager/system-connections/99-idarsi-test.nmconnection --chmod 0600:/etc/NetworkManager/system-connections/99-idarsi-test.nmconnection --selinux-relabel)
      "${customize[@]}" >&2
      publish_overlay
    elif [[ "$base_mode" == auto ]]; then
      command -v qemu-img >/dev/null || { printf 'qemu-img is required; run install.sh kvm.\n' >&2; exit 1; }
      command -v virt-customize >/dev/null || { printf 'virt-customize is required; install libguestfs-tools-c with install.sh kvm.\n' >&2; exit 1; }
      source_arg=$install_source
      if [[ -z "$source_arg" ]]; then
        os_key=$(basename "$kickstart_template" | sed -nE 's/.*rocky([0-9]+).*/rocky\1/ip' | tr '[:upper:]' '[:lower:]')
        [[ -n "$os_key" ]] || { printf 'Cannot infer OS for base image; provide install_source.\n' >&2; exit 1; }
        source_arg="base-only:$os_key"
      fi
      base_image=$("$(dirname "${BASH_SOURCE[0]}")/kvm-base-image" ensure "$source_arg" "$kickstart_template" "$ssh_user" "$disk_size" "$network" "$uri")
      create_overlay "$base_image"
      virt-sysprep --operations defaults -a "$overlay_tmp_file" >&2
      customize=(virt-customize -a "$overlay_tmp_file" --hostname "$instance" --ssh-inject "$ssh_user:file:$key_file.pub")
      if [[ -n "$ipv4_address" ]]; then
        network_file="$MOLECULE_EPHEMERAL_DIRECTORY/${domain}.nmconnection"
        python3 - "$network_file" "$instance" "$ipv4_address" "$gateway" "$netmask" "$nameserver" <<'PY'
import ipaddress
import sys
path, name, address, gateway, netmask, nameserver = sys.argv[1:]
for value in (address, gateway, nameserver):
    ipaddress.IPv4Address(value)
if "/" in netmask:
    raise SystemExit("KVM_NETMASK must be a dotted IPv4 netmask, not a prefix length")
ipaddress.IPv4Address(netmask)
prefix = ipaddress.IPv4Network(f"0.0.0.0/{netmask}").prefixlen
with open(path, "w") as f:
    f.write(f"[connection]\nid=idarsi-test-{name}\ntype=ethernet\nautoconnect=true\nautoconnect-priority=999\nmatch-device=type:ethernet\n")
    f.write(f"[ipv4]\nmethod=manual\naddress1={address}/{prefix},{gateway}\ndns={nameserver};\n")
    f.write("[ipv6]\nmethod=disabled\n")
PY
        customize+=(
          --upload "$network_file:/etc/NetworkManager/system-connections/99-idarsi-test.nmconnection"
          --chown 0:0:/etc/NetworkManager/system-connections/99-idarsi-test.nmconnection
          --chmod 0600:/etc/NetworkManager/system-connections/99-idarsi-test.nmconnection
        )
      fi
      customize+=(--selinux-relabel)
      "${customize[@]}" >&2
      publish_overlay
    elif [[ $image_mode != true ]]; then
      [[ -n "$install_source" && "$install_source" != base-only:* ]] || { printf 'No compatible base image or ISO source is available. Run install.sh kvm and provide/download the Rocky ISO.\n' >&2; exit 1; }
      [[ "$install_source" == http://* || "$install_source" == https://* || -r "$install_source" ]] || { printf 'Install ISO or source path not found: %s\n' "$install_source" >&2; exit 1; }
    fi
    network_configuration='network --bootproto=dhcp --device=link --activate'
    if [[ -n "$ipv4_address" ]]; then
      python3 - "$ipv4_address" "$gateway" "$netmask" "$nameserver" <<'PY'
import ipaddress
import sys

address, gateway, netmask, nameserver = sys.argv[1:]
for value in (address, gateway, nameserver):
    ipaddress.IPv4Address(value)
if "/" in netmask:
    raise SystemExit("KVM_NETMASK must be a dotted IPv4 netmask, not a prefix length")
ipaddress.IPv4Address(netmask)
ipaddress.IPv4Network(f"0.0.0.0/{netmask}")
PY
      network_configuration="network --bootproto=static --ip=${ipv4_address} --netmask=${netmask} --gateway=${gateway} --nameserver=${nameserver} --device=link --activate"
    fi
    if [[ $image_mode != true ]]; then
    rendered_kickstart="$MOLECULE_EPHEMERAL_DIRECTORY/${domain}.ks.cfg"
    python3 - "$kickstart_template" "$rendered_kickstart" "$ssh_user" "$public_key" "$network_configuration" <<'PY'
from pathlib import Path
import sys

source, target, user, public_key, network_configuration = sys.argv[1:]
template = Path(source).read_text()
if "@@NETWORK_CONFIGURATION@@" not in template:
    raise SystemExit("Kickstart template must contain @@NETWORK_CONFIGURATION@@")
rendered = (template.replace("@@SSH_USER@@", user)
            .replace("@@SSH_PUBLIC_KEY@@", public_key)
            .replace("@@NETWORK_CONFIGURATION@@", network_configuration))
if "@@" in rendered:
    raise SystemExit("Kickstart template contains an unrecognized placeholder")
Path(target).write_text(rendered)
Path(target).chmod(0o600)
PY
    fi
    [[ ! -e $ownership_marker && ! -L $ownership_marker ]] || {
      printf 'VM ownership marker already exists: %s. Run molecule destroy first.\n' "$ownership_marker" >&2
      exit 1
    }
    log_root=${KVM_LOG_DIR:-${TMPDIR:-/tmp}/idarsi-ansible-test-environments/kvm-logs}
    mkdir -p "$log_root"
    find "$log_root" -maxdepth 1 -type f -name 'molecule-*.virt-install.log' -mtime +7 -delete
    install_log="$log_root/${domain}.virt-install.log"
    deadline=$((SECONDS + timeout_seconds))
    virt_install_wait_minutes=$(((timeout_seconds + 59) / 60))
    disk_argument="size=${disk_size},format=qcow2,bus=virtio"
    explicit_disk_path=
    explicit_disk_owned=false
    explicit_disk_tmp_dir=
    explicit_domain_cleanup=true
    explicit_domain_uuid=$invocation_uuid
    virt_install_pid=
    virt_install_attempted=false
    cleanup_invocation_domain() {
      local actual_uuid
      [[ $virt_install_attempted == true ]] || return 0
      [[ $explicit_domain_cleanup == true && -n $explicit_domain_uuid ]] || return 0
      if ! actual_uuid=$(LC_ALL=C "${virsh_cmd[@]}" domuuid "$domain" 2>&1); then
        # Check both identities: the invocation domain may have been renamed.
        domain_is_absent "$explicit_domain_uuid"
        return
      fi
      [[ ${actual_uuid,,} == ${explicit_domain_uuid,,} ]] || return 1
      remove_owned_domain "$explicit_domain_uuid"
    }
    stop_virt_install() {
      if [[ -n "$virt_install_pid" ]]; then
        # Until wait reaps this child, its PID cannot be reused by another
        # process. Keep it tracked through both termination and wait.
        kill -TERM "$virt_install_pid" 2>/dev/null || true
        wait "$virt_install_pid" 2>/dev/null || true
        virt_install_pid=
      fi
    }
    explicit_cleanup() {
      stop_virt_install
      # The invocation UUID proves ownership; a same-name collision is never
      # sufficient reason to destroy or undefine a domain.
      if ! cleanup_invocation_domain; then
        printf 'Unable to verify invocation VM removal; preserving storage and recovery files.\n' >&2
        return
      fi
      # As with overlays, ln publication precedes setting the flag. The
      # staging hard link is evidence of ownership during that short window.
      if [[ $explicit_disk_owned == true || ( -n ${explicit_disk_tmp:-} && -e $explicit_disk_path && -e $explicit_disk_tmp && $explicit_disk_path -ef $explicit_disk_tmp ) ]]; then
        rm -f -- "$explicit_disk_path"
        explicit_disk_owned=false
      fi
      if [[ -n $explicit_disk_tmp_dir ]]; then
        rm -rf -- "$explicit_disk_tmp_dir"
        explicit_disk_tmp_dir=
      fi
      cleanup_overlay
    }
    trap explicit_cleanup EXIT
    trap 'exit 1' HUP INT TERM
    if [[ $image_mode == true || "$base_mode" == auto ]]; then
      disk_argument="path=${overlay},format=qcow2,bus=virtio"
    elif [[ -n ${KVM_DISK_PATH:-} ]]; then
      explicit_disk_path=$KVM_DISK_PATH
      [[ "$explicit_disk_path" != *,* ]] || {
        printf 'Explicit KVM disk path must not contain commas: %s\n' "$explicit_disk_path" >&2
        exit 2
      }
      # Never allow libvirt to create an image under its own uid: create the
      # invocation-owned image as the caller so libvirt can restore ownership.
      [[ ! -e "$explicit_disk_path" && ! -L "$explicit_disk_path" ]] || {
        printf 'Explicit KVM disk path already exists or is a symlink: %s\n' "$explicit_disk_path" >&2
        exit 1
      }
      command -v qemu-img >/dev/null || { printf 'qemu-img is required\n' >&2; exit 1; }
      explicit_disk_tmp_dir=$(mktemp -d "$(dirname "$explicit_disk_path")/.kvm-disk.XXXXXXXX")
      explicit_disk_tmp="$explicit_disk_tmp_dir/disk.qcow2"
      if ! (umask 077; qemu-img create -f qcow2 "$explicit_disk_tmp" "${disk_size}G") >/dev/null; then
        rm -rf -- "$explicit_disk_tmp_dir"
        explicit_disk_tmp_dir=
        printf 'qemu-img failed to create explicit KVM disk: %s\n' "$explicit_disk_path" >&2
        exit 1
      fi
      if ! ln -- "$explicit_disk_tmp" "$explicit_disk_path"; then
        rm -rf -- "$explicit_disk_tmp_dir"
        explicit_disk_tmp_dir=
        printf 'Explicit KVM disk path appeared before publication: %s\n' "$explicit_disk_path" >&2
        exit 1
      fi
      explicit_disk_owned=true
      rm -rf -- "$explicit_disk_tmp_dir"
      explicit_disk_tmp_dir=
      trap explicit_cleanup EXIT
      trap 'exit 1' HUP INT TERM
      chmod 600 -- "$explicit_disk_path" || {
        rm -f -- "$explicit_disk_path"
        exit 1
      }
      [[ -f "$explicit_disk_path" && ! -L "$explicit_disk_path" ]] || {
        printf 'qemu-img did not create a regular disk image at %s\n' "$explicit_disk_path" >&2
        rm -f -- "$explicit_disk_path"
        exit 1
      }
      disk_argument="path=${explicit_disk_path},format=qcow2,bus=virtio"
    fi
    virt_install_args=(--connect "$uri" \
      --name "$domain" \
      --memory "$memory" \
      --vcpus "$vcpus" \
      --disk "$disk_argument" \
      --network "network=${network},model=virtio" \
      --os-variant generic \
      --graphics none \
      --noautoconsole)
    virt_install_args+=(--uuid "$explicit_domain_uuid")
    if [[ ${KVM_CPU_HOST_PASSTHROUGH:-false} == true ]]; then
      virt_install_args+=(--cpu host-passthrough)
    fi
    if [[ $image_mode == true || "$base_mode" == auto ]]; then
      virt_install_args+=(--import)
    elif [[ $image_mode != true ]]; then
      virt_install_args+=(--location "$install_source" --initrd-inject "$rendered_kickstart" --extra-args "inst.ks=file:/$(basename "$rendered_kickstart") console=ttyS0,115200n8" --wait "$virt_install_wait_minutes")
    fi
    virt_install_attempted=true
    virt-install "${virt_install_args[@]}" >"$install_log" 2>&1 &
    virt_install_pid=$!
    last_progress_notice=$SECONDS
    while :; do
      process_state=$(ps -o stat= -p "$virt_install_pid" 2>/dev/null || true)
      [[ -n $process_state && $process_state != Z* ]] || break
      if ((SECONDS - last_progress_notice >= 30)); then
        printf 'Still installing %s from its OS source; details: %s\n' "$instance" "$install_log" >&2
        last_progress_notice=$SECONDS
      fi
      sleep 5
    done
    if wait "$virt_install_pid"; then
      virt_install_pid=
    else
      virt_install_pid=
      printf 'virt-install failed. Install log: %s\n' "$install_log" >&2
      cat "$install_log" >&2
      exit 1
    fi

    address=$ipv4_address
    last_progress_notice=$SECONDS
    while (( SECONDS < deadline )); do
      if "${virsh_cmd[@]}" dominfo "$domain" >/dev/null 2>&1; then
        guest_state=$("${virsh_cmd[@]}" domstate "$domain" 2>/dev/null || true)
        if [[ "$guest_state" != running ]]; then
          printf 'VM %s stopped before SSH became ready (state: %s). Install log: %s\n' \
            "$domain" "${guest_state:-unknown}" "$install_log" >&2
          if [[ $explicit_disk_owned == true ]]; then
            cleanup_invocation_domain
            rm -f -- "$explicit_disk_path"
          else
            cleanup_invocation_domain
          fi
          exit 1
        fi
        if [[ -z "$address" ]]; then
          address=$("${virsh_cmd[@]}" domifaddr "$domain" --source lease --full 2>/dev/null | awk '$3 == "ipv4" {sub(/\/.*/, "", $4); print $4; exit}') || address=''
        fi
        if [[ -n "$address" ]] && ssh -F /dev/null -i "$key_file" \
          -o BatchMode=yes -o ConnectTimeout=4 -o StrictHostKeyChecking=no \
          -o UserKnownHostsFile=/dev/null "$ssh_user@$address" true >/dev/null 2>&1; then
          break
        fi
      fi
      if ((SECONDS - last_progress_notice >= 30)); then
        printf 'Waiting for SSH on %s (%s seconds elapsed); install log: %s\n' \
          "$instance" "$((SECONDS - deadline + timeout_seconds))" "$install_log" >&2
        last_progress_notice=$SECONDS
      fi
      sleep 5
    done
    if [[ -z "$address" ]] || ! ssh -F /dev/null -i "$key_file" \
      -o BatchMode=yes -o ConnectTimeout=4 -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null "$ssh_user@$address" true >/dev/null 2>&1; then
      printf 'VM %s did not become SSH-ready within %s seconds. Install log: %s\n' "$domain" "$timeout_seconds" "$install_log" >&2
      cat "$install_log" >&2
      exit 1
    fi
    domain_uuid=$("${virsh_cmd[@]}" domuuid "$domain")
    if [[ ${domain_uuid,,} != ${invocation_uuid,,} ]]; then
      printf 'VM %s UUID does not match this create invocation; refusing ownership marker publication.\n' "$domain" >&2
      exit 1
    fi
    marker_tmp=$(mktemp "$MOLECULE_EPHEMERAL_DIRECTORY/.kvm-${instance}.uuid.XXXXXXXX")
    if ! (umask 077; printf '%s\n' "${domain_uuid,,}" >"$marker_tmp") || ! chmod 600 "$marker_tmp" || ! ln -- "$marker_tmp" "$ownership_marker"; then
      rm -f -- "$marker_tmp"
      printf 'Unable to publish VM ownership marker; cleaning up this invocation.\n' >&2
      exit 1
    fi
    rm -f -- "$marker_tmp"
    KVM_INSTANCE="$instance" KVM_ADDRESS="$address" KVM_USER="$ssh_user" KVM_KEY_FILE="$key_file" KVM_DOMAIN_UUID="$domain_uuid" python3 - <<'PY'
import json
import os

print(json.dumps({
    "instance": os.environ["KVM_INSTANCE"],
    "address": os.environ["KVM_ADDRESS"],
    "user": os.environ["KVM_USER"],
    "port": "22",
    "identity_file": os.environ["KVM_KEY_FILE"],
    "uuid": os.environ["KVM_DOMAIN_UUID"],
}))
PY
    explicit_disk_owned=false
    explicit_domain_cleanup=false
    overlay_owned=false
    trap - EXIT HUP INT TERM
fi
