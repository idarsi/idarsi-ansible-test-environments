#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
versions="$repo_root/versions.yml"

version_value() {
  local section=$1 key=$2
  awk -F'"' -v section="$section" -v key="$key" '
    $0 == section ":" { in_section=1; next }
    /^[^[:space:]#]/ { in_section=0 }
    in_section && $1 ~ "^  " key ":" { print $2; exit }
  ' "$versions"
}

for environment in ansible-min ansible-current ansible-next; do
  key=${environment#ansible-}
  ansible_version=$(version_value ansible "$key")
  python_version=$(version_value python "$key")
  requirements="$repo_root/environments/$environment/requirements.txt"
  collections="$repo_root/environments/$environment/requirements.yml"

  for pin in \
    "ansible-core==$ansible_version" \
    "ansible-runner==$(awk -F'"' '/^ansible_runner:/{print $2}' "$versions")" \
    "ansible-lint==$(awk -F'"' '/^ansible_lint:/{print $2}' "$versions")" \
    "molecule==$(awk -F'"' '/^molecule:/{print $2}' "$versions")" \
    "molecule-plugins[podman]==$(awk -F'"' '/^molecule_podman:/{print $2}' "$versions")"; do
    grep -Fxq "$pin" "$requirements" || {
      printf 'Missing pin %s in %s\n' "$pin" "$requirements" >&2
      exit 1
    }
  done

  for collection in ansible.posix containers.podman; do
    case "$collection" in
      ansible.posix) version_key=ansible_posix ;;
      containers.podman) version_key=containers_podman ;;
    esac
    expected=$(awk -F'"' -v key="$version_key" '$0 ~ "^  " key ":" {print $2; exit}' "$versions")
    awk -v name="$collection" -v expected="$expected" '
      $0 == "  - name: \"" name "\"" { getline; if ($0 == "    version: \"" expected "\"") found=1 }
      END { exit(found ? 0 : 1) }
    ' "$collections" || {
      printf 'Collection pin mismatch: %s (%s)\n' "$environment" "$collection" >&2
      exit 1
    }
  done

  [[ -n "$python_version" ]] || {
    printf 'Python pin missing for %s\n' "$environment" >&2
    exit 1
  }
done

# When checking from an active environment, ensure the pinned collections are
# actually installed there (repository-only checks remain usable without one).
if [[ -n "${VIRTUAL_ENV:-}" ]]; then
  collection_path="$VIRTUAL_ENV/collections/ansible_collections"
  for collection in ansible.posix containers.podman; do
    case "$collection" in
      ansible.posix) namespace=ansible; name=posix; version_key=ansible_posix ;;
      containers.podman) namespace=containers; name=podman; version_key=containers_podman ;;
    esac
    expected=$(awk -F'"' -v key="$version_key" '$0 ~ "^  " key ":" {print $2; exit}' "$versions")
    manifest="$collection_path/$namespace/$name/MANIFEST.json"
    installed=$(python - "$manifest" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as manifest:
        print(json.load(manifest).get("collection_info", {}).get("version", ""))
except (OSError, json.JSONDecodeError):
    print("")
PY
)
    [[ "$installed" == "$expected" ]] || {
      printf 'Required collection %s %s is missing or mismatched in %s (found: %s). Rerun: install.sh <profile> %s\n' \
        "$collection" "$expected" "$VIRTUAL_ENV" "${installed:-missing}" "${VIRTUAL_ENV##*/}" >&2
      exit 1
    }
  done
fi

printf 'Ansible, Ansible Lint, Molecule, and collection pins are synchronized.\n'
