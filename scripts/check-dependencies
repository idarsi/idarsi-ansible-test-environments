#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
versions="$repo_root/versions.yml"

version_value() {
  local section=$1 key=$2
  awk -F'"' -v section="$section" -v key="$key" '
    $0 == section ":" { in_section=1; next }
    /^[^[:space:]#]/ { in_section=0 }
    in_section && $1 ~ "^  " key ":" { print $2; exit }
  ' "$versions"
}

for environment in ansible-min ansible-current ansible-next; do
  key=${environment#ansible-}
  ansible_version=$(version_value ansible "$key")
  python_version=$(version_value python "$key")
  requirements="$repo_root/environments/$environment/requirements.txt"
  collections="$repo_root/environments/$environment/requirements.yml"

  for pin in \
    "ansible-core==$ansible_version" \
    "ansible-runner==$(awk -F'"' '/^ansible_runner:/{print $2}' "$versions")" \
    "ansible-lint==$(awk -F'"' '/^ansible_lint:/{print $2}' "$versions")" \
    "molecule==$(awk -F'"' '/^molecule:/{print $2}' "$versions")" \
    "molecule-plugins[podman]==$(awk -F'"' '/^molecule_podman:/{print $2}' "$versions")"; do
    [[ $(grep -Fxc "$pin" "$requirements") -eq 1 ]] || {
      printf 'Expected exactly one pin %s in %s\n' "$pin" "$requirements" >&2
      exit 1
    }
  done

  for collection in ansible.posix containers.podman; do
    case "$collection" in
      ansible.posix) version_key=ansible_posix ;;
      containers.podman) version_key=containers_podman ;;
    esac
    expected=$(awk -F'"' -v key="$version_key" '$0 ~ "^  " key ":" {print $2; exit}' "$versions")
    [[ $(grep -Ec "^  $version_key:" "$versions") -eq 1 ]] || {
      printf 'Expected exactly one declared pin for %s in %s\n' "$collection" "$versions" >&2
      exit 1
    }
    [[ $(grep -Fc "  - name: \"$collection\"" "$collections") -eq 1 ]] || {
      printf 'Expected exactly one declaration for %s in %s\n' "$collection" "$collections" >&2
      exit 1
    }
    awk -v name="$collection" -v expected="$expected" '
      $0 == "  - name: \"" name "\"" { getline; if ($0 == "    version: \"" expected "\"") found=1 }
      END { exit(found ? 0 : 1) }
    ' "$collections" || {
      printf 'Collection pin mismatch: %s (%s)\n' "$environment" "$collection" >&2
      exit 1
    }
  done

  [[ -n "$python_version" ]] || {
    printf 'Python pin missing for %s\n' "$environment" >&2
    exit 1
  }
done

# When checking from an active environment, ensure the pinned collections are
# actually installed there (repository-only checks remain usable without one).
if [[ -n "${VIRTUAL_ENV:-}" ]]; then
  if ! config=$(ansible-config dump --format json); then
    printf 'Failed to read Ansible configuration with ansible-config.\n' >&2
    exit 1
  fi
  paths_file=$(mktemp "${TMPDIR:-/tmp}/idarsi-collections-paths.XXXXXX")
  trap 'rm -f "$paths_file"' EXIT
  if ! python - "$config" >"$paths_file" <<'PYCONFIG'
import json
import sys

try:
    records = json.loads(sys.argv[1])
except json.JSONDecodeError as error:
    print(f"Invalid ansible-config JSON: {error}", file=sys.stderr)
    raise SystemExit(1)
if not isinstance(records, list):
    print("Expected ansible-config JSON list of records", file=sys.stderr)
    raise SystemExit(1)
settings = [r for r in records if isinstance(r, dict) and r.get("name") == "COLLECTIONS_PATHS"]
if len(settings) > 1:
    print("Duplicate COLLECTIONS_PATHS records in ansible-config output", file=sys.stderr)
    raise SystemExit(1)
value = settings[0].get("value", []) if settings else []
if isinstance(value, str):
    paths = value.split(":")
elif isinstance(value, list) and all(isinstance(path, str) for path in value):
    paths = value
else:
    print("COLLECTIONS_PATHS must be a string or list of strings", file=sys.stderr)
    raise SystemExit(1)
for path in paths:
    if path:
        sys.stdout.buffer.write(path.encode() + b"\0")
PYCONFIG
  then
    exit 1
  fi
  mapfile -d '' -t collection_paths <"$paths_file"
  if [[ ${#collection_paths[@]} -eq 0 ]]; then
    collection_paths=("$VIRTUAL_ENV/collections")
  fi
  for collection in ansible.posix containers.podman; do
    case "$collection" in
      ansible.posix) namespace=ansible; name=posix; version_key=ansible_posix ;;
      containers.podman) namespace=containers; name=podman; version_key=containers_podman ;;
    esac
    expected=$(awk -F'"' -v key="$version_key" '$0 ~ "^  " key ":" {print $2; exit}' "$versions")
    manifests=()
    for root in "${collection_paths[@]}"; do
      manifest="$root/ansible_collections/$namespace/$name/MANIFEST.json"
      [[ -f "$manifest" ]] && manifests+=("$manifest")
    done
    installed=$(python - "${manifests[@]}" <<'PY'
import json
import sys

for path in sys.argv[1:]:
    try:
        with open(path, encoding="utf-8") as manifest:
            print(json.load(manifest).get("collection_info", {}).get("version", ""))
    except (OSError, json.JSONDecodeError):
        print("")
PY
)
    first=${installed%%$'\n'*}
    [[ -n "$first" && "$first" == "$expected" ]] || {
      first_root=${collection_paths[0]}
      printf 'Required collection %s %s is missing or mismatched; first effective location: %s (manifest: %s; version: %s). Install or repair this collection at that manifest path.\n' \
        "$collection" "$expected" "$first_root" "${manifests[0]:-$first_root/ansible_collections/$namespace/$name/MANIFEST.json}" "${first:-missing}" >&2
      exit 1
    }
    [[ $((${#manifests[@]})) -eq 1 ]] || {
      printf 'Collection %s has duplicate manifests (first effective copy is %s). Remove the later duplicate manifest(s): %s\n' "$collection" "${manifests[0]}" "${manifests[*]:1}" >&2
      exit 1
    }
  done
fi

printf 'Ansible, Ansible Lint, Molecule, and collection pins are synchronized.\n'
