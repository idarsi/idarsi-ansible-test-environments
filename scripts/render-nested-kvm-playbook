#!/usr/bin/env python3
"""Render the playbook used to provision a nested KVM integration guest."""

from pathlib import Path
import json
import sys
import argparse

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("output")
parser.add_argument("vm_name")
parser.add_argument("image_path", nargs="?")
parser.add_argument("--state", choices=("install", "vm_present", "vm_absent", "absent", "validate"), default="install")
parser.add_argument("--purge-data-on-remove", choices=("true", "false"), default="false")
args = parser.parse_args()

if args.image_path and (not Path(args.image_path).is_absolute() or not args.image_path.endswith(".qcow2")):
    raise SystemExit("IMAGE_PATH must be an absolute path ending in .qcow2")

output = Path(args.output)
vm_name = json.dumps(args.vm_name)
source = (
    f'''              type: "image"\n              path: {json.dumps(args.image_path)}\n'''
    if args.image_path
    else '''              type: "iso"\n              path: "/tmp/nested-kvm-install.iso"\n              kickstart: "/tmp/inner.ks"\n              os_variant: "rocky9"\n'''
)
# The image source is already configured by the ISO path; network is ISO-only.
network = "" if len(sys.argv) == 4 else '''            network:
              ipv4:
                address: "192.168.250.210/24"
                gateway: "192.168.250.1"
                nameservers: ["192.168.250.1"]
'''
output.write_text(
    '''---
- name: Provision nested integration guest
  hosts: localhost
  connection: local
  become: true
  gather_facts: true
  vars:
    ansible_python_interpreter: /usr/bin/python3
    ansible_collections_path: /opt/idarsi-nested-kvm/collections
    kvm_network: "idarsi-test"
    state: '''
    + json.dumps(args.state)
    + '''
    iac_blueprint:
      kvm:
        instances:
          - name: '''
    + vm_name
    + '''
            hostname: "nested-role-integration.example.test"
            memory_mb: 2048
            vcpus: 2
            disk_gb: 10
            source:
'''
    + source
    + network
    + f'''            purge_data_on_remove: {args.purge_data_on_remove}
  roles:
    - role: /opt/idarsi-nested-kvm/role
''',
    encoding="utf-8",
)
