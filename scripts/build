#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
engine=${CONTAINER_ENGINE:-podman}
builder=${ANSIBLE_BUILDER:-ansible-builder}
builder_version=$(awk -F'"' '/^ansible_builder:/{print $2; exit}' "$repo_root/versions.yml")
[[ -n "$builder_version" ]] || { printf 'ansible_builder is missing from versions.yml\n' >&2; exit 1; }
builder_image_line=$(awk '/^builder_image:/{print; exit}' "$repo_root/versions.yml")
[[ -n "$builder_image_line" ]] || { printf 'builder_image is missing from versions.yml\n' >&2; exit 1; }
[[ "$builder_image_line" =~ ^builder_image:\ \"([^\"]+)\"$ ]] || {
  printf 'builder_image in versions.yml must be a quoted image reference\n' >&2
  exit 1
}
builder_image_from_versions=${BASH_REMATCH[1]}
[[ "$builder_image_from_versions" =~ ^[^[:space:]]+@sha256:[[:xdigit:]]{64}$ ]] || {
  printf 'builder_image in versions.yml must be a digest-pinned image reference\n' >&2
  exit 1
}
image=${IMAGE:-}
builder_image=${BUILDER_IMAGE:-$builder_image_from_versions}

usage() {
  printf 'Usage: %s [--validate-only] <ansible-min|ansible-current|ansible-next>\n' "$0" >&2
}

validate_only=false
if [[ ${1:-} == "--validate-only" ]]; then
  validate_only=true
  shift
fi
environment=${1:-}
if [[ -z "$environment" || ! -d "$repo_root/environments/$environment" ]]; then
  usage
  exit 2
fi

definition="$repo_root/environments/$environment/execution-environment.yml"
create_context() {
  local destination=$1
  if command -v "$builder" >/dev/null; then
    "$builder" create --file "$definition" --context "$destination"
    return
  fi
  command -v "$engine" >/dev/null || { printf 'ansible-builder or %s is required\n' "$engine" >&2; exit 1; }
  "$engine" run --rm -v "$repo_root:/workspace:Z" -w /workspace \
    "$builder_image" \
    bash -lc 'python -m pip install --quiet "ansible-builder==$3" && ansible-builder create --file "$1" --context "$2"' \
    bash "${definition#"$repo_root/"}" "${destination#"$repo_root/"}" "$builder_version"
}

if "$validate_only"; then
  create_context "$repo_root/.build-$environment"
  rm -rf "$repo_root/.build-$environment"
  exit 0
fi
command -v "$engine" >/dev/null || { printf '%s is required\n' "$engine" >&2; exit 1; }

if [[ -z "$image" ]]; then
  image="localhost/idarsi/ansible-test:$environment"
fi
context="$repo_root/.build-$environment"
rm -rf "$context"
create_context "$context"
"$engine" build --pull=missing --tag "$image" "$context"
"$engine" run --rm --entrypoint /usr/local/bin/ansible-playbook "$image" --version
printf 'Built and smoke-tested %s\n' "$image"
